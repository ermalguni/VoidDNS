[Unit]
Description=VoidDNS DNS forwarder and web management
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/voiddns/voiddns.json

[Service]
Type=simple
User=voiddns
Group=voiddns
WorkingDirectory=/etc/voiddns
ExecStart=/usr/bin/VoidDNS --config /etc/voiddns/voiddns.json --database /var/lib/voiddns/voiddns.sqlite3
StateDirectory=voiddns
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/voiddns

[Install]
WantedBy=multi-user.target
