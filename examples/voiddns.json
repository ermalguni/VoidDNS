{
  "schema_version": 2,
  "dns": {
    "listen": {
      "address": "127.0.0.1",
      "port": 53
    },
    "tcp": {
      "max_connections": 64,
      "idle_timeout_ms": 10000,
      "read_timeout_ms": 5000,
      "write_timeout_ms": 5000
    }
  },
  "upstream": {
    "servers": [
      { "address": "1.1.1.1", "port": 53 },
      { "address": "8.8.8.8", "port": 53 }
    ],
    "timeout_ms": 3000
  },
  "cache": {
    "capacity": 8192,
    "min_positive_ttl_seconds": 900
  },
  "logging": {
    "level": "debug"
  },
  "api": {
    "enabled": true,
    "listen": {
      "address": "127.0.0.1",
      "port": 8080
    },
    "key_file": "api.key",
    "allow_private_sources": false
  },
  "ui": {
    "enabled": true
  },
  "records": [
    {
      "name": "home.test",
      "type": "A",
      "ttl": 60,
      "addresses": ["192.0.2.10", "192.0.2.11"]
    },
    {
      "name": "home.test",
      "type": "AAAA",
      "ttl": 60,
      "addresses": ["2001:db8::10", "2001:db8::11"]
    }
  ],
  "blocks": {
